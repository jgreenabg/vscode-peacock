// Place your settings in this file to overwrite default and user settings.
{
  "files.exclude": {
    "out": false // set this to true to hide the "out" folder with the compiled JS files
  },
  "search.exclude": {
    "out": true // set this to false to include "out" folder in search results
  },
  // Turn off tsc task auto detection since we have the necessary tasks as npm scripts
  "typescript.tsc.autoDetect": "off",
  "workbench.statusBar.visible": true,
  "peacock.color": "#622d59",
  "workbench.colorCustomizations": {
    "sash.hoverBorder": "#853d79",
    "activityBar.activeBackground": "#853d79",
    "activityBar.background": "#853d79",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#282c14",
    "activityBarBadge.foreground": "#e7e7e7",
    "titleBar.activeBackground": "#622d59",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#622d5999",
    "titleBar.inactiveForeground": "#e7e7e799",
    "statusBar.background": "#622d59",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#853d79",
    "statusBarItem.remoteBackground": "#622d59",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "activityBar.activeBorder": "#530c2c",
    "commandCenter.border": "#e7e7e799",
    "activityBarTop.activeBackground": "#853d79",
    "activityBarTop.activeForeground": "#e7e7e7",
    "activityBarTop.background": "#853d79",
    "activityBarTop.inactiveForeground": "#e7e7e799",
    "commandCenter.activeBackground": "#622d59",
    "commandCenter.activeBorder": "#e7e7e799",
    "commandCenter.activeForeground": "#e7e7e7",
    "commandCenter.background": "#622d5999",
    "commandCenter.foreground": "#e7e7e7",
    "commandCenter.inactiveBorder": "#e7e7e799",
    "commandCenter.inactiveForeground": "#e7e7e799"
  }
}
